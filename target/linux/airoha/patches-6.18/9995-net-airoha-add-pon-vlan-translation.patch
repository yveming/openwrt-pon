From: FiberHome HG5582A port <dev@example.invalid>
Date: Sun, 1 Nov 2026 00:00:00 +0800
Subject: [PATCH] net: airoha: add PON service VLAN translation

The operator can carry IPTV multicast on an internal VLAN such as 3990
while the ONU exposes a single service VLAN (pon0.43).  The vendor
ponvlan module performs that translation in the PON data path; the open
driver currently hands every tagged frame to the Linux bridge unchanged,
so a separate multicast VLAN either needs its own Linux interface or is
dropped.

Add a small per-PON translation table and rewrite the inline 802.1Q VID
on receive before the frame reaches the VLAN upper.  The table is exposed
to the xPON sysfs layer through a pair of exported helpers, and is
RCU-protected because the receive path runs in softirq context.  This is
the downstream subset needed by the IPTV integration; it does not create
another Linux netdev and keeps the Linux bridge seeing one service VLAN.

Signed-off-by: FiberHome HG5582A port <dev@example.invalid>
---
--- a/include/linux/airoha-eth.h
+++ b/include/linux/airoha-eth.h
@@ -30,6 +30,19 @@
 
 #define AIROHA_PON_VID_ANY	0xffff
 #define AIROHA_PON_MAX_QDMA_CHANNELS	32
+#define AIROHA_PON_VLAN_MAP_MAX	8
+
+/*
+ * A PON VLAN translation entry rewrites the service VLAN before the frame
+ * reaches the Linux bridge.  It mirrors the vendor ponvlan rule that keeps
+ * IPTV on one visible VLAN (pon0.<service_vlan>) while the operator uses a
+ * separate internal multicast VLAN such as 3990.  to == AIROHA_PON_VID_ANY
+ * requests tag removal.
+ */
+struct airoha_pon_vlan_map {
+	u16 from;
+	u16 to;
+};
 
 /*
  * QDMA is the shared data plane for all PON protocols. Counters accumulate
@@ -88,6 +101,12 @@
 int airoha_eth_pon_replace_flows(
 	struct net_device *netdev, const struct airoha_pon_flow_config *flows,
 	unsigned int count);
+int airoha_eth_pon_set_vlan_map(struct net_device *netdev,
+				const struct airoha_pon_vlan_map *map,
+				unsigned int count);
+int airoha_eth_pon_get_vlan_map(struct net_device *netdev,
+				struct airoha_pon_vlan_map *map,
+				unsigned int max_count);
 int airoha_eth_pon_configure_epon(struct net_device *netdev, u8 channel,
 				  bool valid);
 int airoha_eth_pon_get_datapath_stats(
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -671,6 +671,11 @@
 	u32 last_rx_msg1;
 };
 
+struct airoha_pon_vlan_map_table {
+	unsigned int count;
+	struct airoha_pon_vlan_map map[];
+};
+
 struct airoha_gdm_dev {
 	struct airoha_qdma __rcu *qdma;
 	struct airoha_gdm_port *port;
@@ -687,6 +692,8 @@
 
 	u32 pon_qdma_tag;
 	struct airoha_pon_flow_table __rcu *pon_flow_table;
+	/* Service VLAN translation applied before the Linux bridge. */
+	struct airoha_pon_vlan_map_table __rcu *pon_vlan_map;
 	const struct airoha_pon_link_ops *pon_link_ops;
 	void *pon_link_priv;
 	struct airoha_pon_datapath_counters pon_stats;
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -4,10 +4,12 @@
  * Author: Lorenzo Bianconi <lorenzo@kernel.org>
  */
 #include <linux/airoha-eth.h>
+#include <linux/if_vlan.h>
 #include <linux/of.h>
 #include <linux/of_net.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
+#include <linux/rtnetlink.h>
 #include <linux/slab.h>
 #include <linux/tcp.h>
 #include <linux/pcs/pcs.h>
@@ -983,6 +985,64 @@
 	rcu_read_unlock();
 }
 
+/*
+ * Rewrite the inline service VLAN before eth_type_trans() hands the frame to
+ * the VLAN upper.  This is the small, downstream-only subset of the vendor
+ * ponvlan rule engine needed to keep an operator multicast VLAN (for
+ * example 3990) internal while exposing a single pon0.<service_vlan>.
+ */
+static void airoha_pon_vlan_translate_rx(struct airoha_gdm_dev *dev,
+					 struct sk_buff *skb)
+{
+	struct airoha_pon_vlan_map_table *table;
+	struct vlan_ethhdr *veh;
+	unsigned int i;
+	u16 vid, tci;
+
+	if (!skb || !test_bit(AIROHA_DEV_F_PON, &dev->flags))
+		return;
+
+	rcu_read_lock();
+	table = rcu_dereference(dev->pon_vlan_map);
+	if (!table || !table->count)
+		goto unlock;
+
+	if (skb_vlan_tag_present(skb)) {
+		vid = skb_vlan_tag_get_id(skb);
+		for (i = 0; i < table->count; i++) {
+			if (table->map[i].from != vid)
+				continue;
+			if (table->map[i].to == AIROHA_PON_VID_ANY)
+				__vlan_hwaccel_clear_tag(skb);
+			else
+				__vlan_hwaccel_put_tag(skb, skb->vlan_proto,
+						       table->map[i].to);
+			break;
+		}
+		goto unlock;
+	}
+
+	if (!eth_type_vlan(skb->protocol) || skb->len < VLAN_ETH_HLEN ||
+	    !skb_mac_header_was_set(skb))
+		goto unlock;
+
+	veh = (struct vlan_ethhdr *)skb_mac_header(skb);
+	tci = ntohs(veh->h_vlan_TCI);
+	vid = tci & VLAN_VID_MASK;
+	for (i = 0; i < table->count; i++) {
+		if (table->map[i].from != vid)
+			continue;
+		if (table->map[i].to != AIROHA_PON_VID_ANY)
+			veh->h_vlan_TCI = htons((tci & ~VLAN_VID_MASK) |
+						(table->map[i].to &
+						 VLAN_VID_MASK));
+		break;
+	}
+
+unlock:
+	rcu_read_unlock();
+}
+
 static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 {
 	enum dma_data_direction dir = page_pool_get_dma_dir(q->page_pool);
@@ -1101,6 +1161,15 @@
 		if (FIELD_GET(QDMA_DESC_MORE_MASK, desc_ctrl))
 			continue;
 
+		/*
+		 * Rewrite the service VLAN before the PPE cache-miss hook and
+		 * the bridge both look at the frame.  The hardware L2B key keeps
+		 * the original ingress VLAN, while the software template carries
+		 * the translated egress VLAN.
+		 */
+		if (test_bit(AIROHA_DEV_F_PON, &dev->flags))
+			airoha_pon_vlan_translate_rx(dev, q->skb);
+
 		if (netdev_uses_dsa(netdev)) {
 			struct airoha_gdm_port *port = dev->port;
 
@@ -4433,6 +4502,76 @@
 }
 EXPORT_SYMBOL_GPL(airoha_eth_pon_configure);
 
+int airoha_eth_pon_set_vlan_map(struct net_device *netdev,
+				const struct airoha_pon_vlan_map *map,
+				unsigned int count)
+{
+	struct airoha_pon_vlan_map_table *table = NULL, *old;
+	struct airoha_gdm_dev *dev;
+	unsigned int i;
+
+	if (!netdev || netdev->netdev_ops != &airoha_netdev_ops)
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!test_bit(AIROHA_DEV_F_PON, &dev->flags))
+		return -EOPNOTSUPP;
+	if (count > AIROHA_PON_VLAN_MAP_MAX)
+		return -EINVAL;
+
+	if (count) {
+		table = kzalloc(struct_size(table, map, count), GFP_KERNEL);
+		if (!table)
+			return -ENOMEM;
+		table->count = count;
+		for (i = 0; i < count; i++) {
+			if (map[i].from > VLAN_VID_MASK ||
+			    (map[i].to > VLAN_VID_MASK &&
+			     map[i].to != AIROHA_PON_VID_ANY)) {
+				kfree(table);
+				return -EINVAL;
+			}
+			table->map[i] = map[i];
+		}
+	}
+
+	rtnl_lock();
+	old = rcu_replace_pointer(dev->pon_vlan_map, table, true);
+	rtnl_unlock();
+
+	if (old) {
+		synchronize_rcu();
+		kfree(old);
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_set_vlan_map);
+
+int airoha_eth_pon_get_vlan_map(struct net_device *netdev,
+				struct airoha_pon_vlan_map *map,
+				unsigned int max_count)
+{
+	struct airoha_pon_vlan_map_table *table;
+	struct airoha_gdm_dev *dev;
+	unsigned int i, count;
+
+	if (!netdev || netdev->netdev_ops != &airoha_netdev_ops || !map)
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!test_bit(AIROHA_DEV_F_PON, &dev->flags))
+		return -EOPNOTSUPP;
+
+	rcu_read_lock();
+	table = rcu_dereference(dev->pon_vlan_map);
+	count = table ? min(table->count, max_count) : 0;
+	for (i = 0; i < count; i++)
+		map[i] = table->map[i];
+	rcu_read_unlock();
+
+	return count;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_get_vlan_map);
+
 int airoha_eth_pon_configure_epon(struct net_device *netdev, u8 channel,
 				  bool valid)
 {
@@ -5114,6 +5253,8 @@
 
 			netdev = netdev_from_priv(dev);
 			unregister_netdev(netdev);
+			synchronize_net();
+			kfree(rcu_access_pointer(dev->pon_vlan_map));
 			if (dev->phylink)
 				phylink_destroy(dev->phylink);
 			of_node_put(netdev->dev.of_node);
