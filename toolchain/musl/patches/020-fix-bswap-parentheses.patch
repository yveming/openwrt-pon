From: FiberHome HG5582A port <dev@example.invalid>
Subject: [PATCH] fix bswap macro parentheses for -Werror builds

The byte-swap helpers rely on C operator precedence in expressions that
mix shifts, masks and addition.  GCC 14 diagnoses the unparenthesized
forms under -Werror=parentheses, which breaks packages such as fwtool.
Spell out the intended grouping without changing the result.

--- a/include/endian.h
+++ b/include/endian.h
@@ -23,12 +23,13 @@
 
 static __inline uint32_t __bswap32(uint32_t __x)
 {
-	return __x>>24 | __x>>8&0xff00 | __x<<8&0xff0000 | __x<<24;
+	return (__x>>24) | ((__x>>8) & 0xff00) |
+	       ((__x<<8) & 0xff0000) | (__x<<24);
 }
 
 static __inline uint64_t __bswap64(uint64_t __x)
 {
-	return __bswap32(__x)+0ULL<<32 | __bswap32(__x>>32);
+	return ((uint64_t)__bswap32(__x) << 32) | __bswap32(__x>>32);
 }
 
 #if __BYTE_ORDER == __LITTLE_ENDIAN
--- a/include/byteswap.h
+++ b/include/byteswap.h
@@ -11,12 +11,13 @@
 
 static __inline uint32_t __bswap_32(uint32_t __x)
 {
-	return __x>>24 | __x>>8&0xff00 | __x<<8&0xff0000 | __x<<24;
+	return (__x>>24) | ((__x>>8) & 0xff00) |
+	       ((__x<<8) & 0xff0000) | (__x<<24);
 }
 
 static __inline uint64_t __bswap_64(uint64_t __x)
 {
-	return __bswap_32(__x)+0ULL<<32 | __bswap_32(__x>>32);
+	return ((uint64_t)__bswap_32(__x) << 32) | __bswap_32(__x>>32);
 }
 
 #define bswap_16(x) __bswap_16(x)
